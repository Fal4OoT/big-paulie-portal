# ---------------------------------------------------------------
# Big Paulie Portal — copier en .env puis remplir.
# ---------------------------------------------------------------

# URL publique du portail, sans slash final.
# Local : http://localhost:8081   ·   Production : https://bigpaulie.falaoot.fr
PUBLIC_URL=http://localhost:8081

# Mot de passe PostgreSQL (long et aléatoire).
POSTGRES_PASSWORD=change-moi

# Application Discord (https://discord.com/developers/applications)
#  - OAuth2 > Client ID / Client Secret
#  - OAuth2 > Redirects : ajouter  <PUBLIC_URL>/api/auth/callback
#  - Bot > Token
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# ID du serveur Discord du Big Paulie (mode développeur > clic droit sur le serveur > Copier l'identifiant)
DISCORD_GUILD_ID=

# Tes IDs Discord ayant tous les droits (pour la première configuration), séparés par des virgules.
ADMIN_DISCORD_IDS=

# Clé partagée API <-> bot (au moins 32 caractères aléatoires).
# Linux/macOS : openssl rand -hex 32
INTERNAL_API_KEY=

# Port local de la stack (le proxy HTTPS du VPS pointe dessus). 8081 évite le conflit avec le portail PA.
BP_HTTP_PORT=8081
# Adresse d'écoute : 127.0.0.1 par défaut. Voir docs/DEPLOIEMENT.md si ton proxy HTTPS tourne dans Docker.
BP_BIND=127.0.0.1

PORTAL_TIMEZONE=Europe/Paris
