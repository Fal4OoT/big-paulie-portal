# Routage interne de la stack Big Paulie (HTTP simple, derrière le proxy HTTPS du VPS).
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	handle /api/* {
		# Endpoints réservés au bot (réseau Docker interne) : jamais exposés à l'extérieur.
		@internal path /api/internal /api/internal/*
		respond @internal 404

		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
